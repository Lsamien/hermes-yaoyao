HERMES_YAOYAO_HOST=127.0.0.1
HERMES_YAOYAO_PORT=8800
HERMES_YAOYAO_UPSTREAM=http://127.0.0.1:9119
# Comma-separated additional DNS names. Localhost and active private IP literals are allowed automatically.
HERMES_YAOYAO_ALLOWED_HOSTS=
# For LAN access set HOST=0.0.0.0 and either configure TLS or explicitly enable trusted-LAN HTTP below.
HERMES_YAOYAO_ALLOW_INSECURE_LAN=0
# The managed LaunchAgent sets this to 1 and keeps the local Hermes Dashboard on 9119 available.
HERMES_YAOYAO_SUPERVISE_DASHBOARD=0
# HERMES_YAOYAO_TLS_CERT=/absolute/path/to/cert.pem
# HERMES_YAOYAO_TLS_KEY=/absolute/path/to/key.pem
# HERMES_YAOYAO_HOME=/Users/you/.hermes-yaoyao
