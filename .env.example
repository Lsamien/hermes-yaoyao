# Manual npm/Docker runs stay loopback-only unless changed; macOS `service install` defaults to 0.0.0.0.
HERMES_YAOYAO_HOST=127.0.0.1
HERMES_YAOYAO_PORT=8800
HERMES_YAOYAO_UPSTREAM=http://127.0.0.1:9119
# Comma-separated additional DNS names. Localhost and active private IP literals are allowed automatically.
HERMES_YAOYAO_ALLOWED_HOSTS=
# For manual LAN access set HOST=0.0.0.0 and either configure TLS or explicitly enable trusted-LAN HTTP below.
HERMES_YAOYAO_ALLOW_INSECURE_LAN=0
# The managed LaunchAgent sets this to 1 and keeps the local Hermes Dashboard on 9119 available.
HERMES_YAOYAO_SUPERVISE_DASHBOARD=0
# HERMES_YAOYAO_TLS_CERT=/absolute/path/to/cert.pem
# HERMES_YAOYAO_TLS_KEY=/absolute/path/to/key.pem
# HERMES_YAOYAO_HOME=/Users/you/.hermes-yaoyao
# iOS 后台通知使用 APNs Token Key。四项中前三项必须同时配置，.p8 不得放入仓库。
# HERMES_YAOYAO_APNS_KEY_FILE=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# HERMES_YAOYAO_APNS_KEY_ID=XXXXXXXXXX
# HERMES_YAOYAO_APNS_TEAM_ID=GMU6W5FKQ6
# HERMES_YAOYAO_APNS_TOPIC=cn.samien.yaoyao.hermes
# 固定 Git 发布源。系统更新只接受这里发现的 vX.Y.Z 标签，不接受浏览器指定仓库。
# HERMES_YAOYAO_RELEASE_SOURCE=https://git.samien.cn/samien/hermes-yaoyao.git
# HERMES_YAOYAO_RELEASE_ROOT=/Users/you/.local/share/hermes-yaoyao
# 系统更新默认仅允许从本机浏览器触发；可信网络确有需要时才显式开启。
# HERMES_YAOYAO_ALLOW_REMOTE_UPDATE=0
