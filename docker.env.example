# 宿主机仅在本机发布 8800；需要通过反向代理或可信局域网访问时再改为 0.0.0.0。
HERMES_YAOYAO_BIND_ADDRESS=127.0.0.1
HERMES_YAOYAO_PUBLISHED_PORT=8800

# 9119 由项目外部的 Hermes Dashboard 提供，Compose 不会创建、启动或停止它。
# Docker Desktop 可用这个地址访问宿主机；Linux 上的 9119 还必须监听容器可达的宿主机地址。
HERMES_YAOYAO_UPSTREAM=http://host.docker.internal:9119
# HERMES_YAOYAO_UPSTREAM_USERNAME=yaoyao-service
# HERMES_YAOYAO_UPSTREAM_PASSWORD_FILE=/run/secrets/hermes_dashboard_password

# 使用域名访问时填写域名，多个值以英文逗号分隔；localhost 和私网 IP 无需填写。
HERMES_YAOYAO_ALLOWED_HOSTS=
